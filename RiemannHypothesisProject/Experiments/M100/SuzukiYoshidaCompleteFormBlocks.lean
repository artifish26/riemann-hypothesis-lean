import RiemannHypothesisProject.Experiments.M100.SuzukiYoshidaSourceClosure
import RiemannHypothesisProject.Experiments.M100.SuzukiEndpointComplexCoordinates
import RiemannHypothesisProject.Experiments.M100.SuzukiConcreteReflectionEquivariance

/-!
# Actual complete-form blocks for M100-DF6D5B3

This module puts the B2S completion-valued Yoshida decomposition into the
actual frozen Suzuki complete form.  The Hermitian algebraic block identity is
proved unconditionally.  The three analytic identifications still required by
B3 are exposed separately: the low matrix identity, far coercivity, and the
residual-to-actual-cross estimate.

The displayed propositions are diagnostic theorem targets.  They are not
bundled into a certificate and no theorem in this module assumes them in order
to claim the B3 endpoint.
-/

namespace RiemannHypothesisProject.Experiments.M100

noncomputable section

open scoped ComplexConjugate

/-- The actual frozen complete form on the live logarithmic Hilbert
completion. -/
def suzukiProjectLogRadiusLinearCompleteEnergy
    (u v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar) : Complex :=
  suzukiLogRadiusLinearCompleteEnergy
    (suzukiProjectPrimeIndexSet suzukiProjectAStar)
    suzukiProjectCompleteScalar
    suzukiProjectPrimeCoefficient
    suzukiProjectPrimeShift
    (suzukiRSecondSourceRemainderOperator suzukiProjectAStar)
    u v

/-- The frozen complete form is Hermitian. -/
theorem suzukiProjectLogRadiusLinearCompleteEnergy_conj_symm
    (u v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar) :
    suzukiProjectLogRadiusLinearCompleteEnergy u v =
      conj (suzukiProjectLogRadiusLinearCompleteEnergy v u) := by
  exact suzukiRSecondLogRadiusLinearCompleteEnergy_conj_symm
    suzukiProjectAStar
    (suzukiProjectPrimeIndexSet suzukiProjectAStar)
    suzukiProjectCompleteScalar
    suzukiProjectPrimeCoefficient
    suzukiProjectPrimeShift
    u v

/-- Exact low/cross/far expansion for the actual complete form. -/
theorem suzukiProjectLogRadiusLinearCompleteEnergy_block
    (low far : SuzukiLogRadiusLinearCompletion suzukiProjectAStar) :
    (suzukiProjectLogRadiusLinearCompleteEnergy
        (low + far) (low + far)).re =
      (suzukiProjectLogRadiusLinearCompleteEnergy low low).re +
        2 * (suzukiProjectLogRadiusLinearCompleteEnergy low far).re +
        (suzukiProjectLogRadiusLinearCompleteEnergy far far).re := by
  have hcross :=
    suzukiProjectLogRadiusLinearCompleteEnergy_conj_symm far low
  unfold suzukiProjectLogRadiusLinearCompleteEnergy at hcross ⊢
  rw [suzukiLogRadiusLinearCompleteEnergy_add_left,
    suzukiLogRadiusLinearCompleteEnergy_add_right,
    suzukiLogRadiusLinearCompleteEnergy_add_right,
    hcross]
  simp only [Complex.add_re, Complex.conj_re]
  ring

/-- Actual even low-low value generated by the B2S completion reconstruction. -/
def SuzukiB2EndpointModeCertificate.evenActualLowValue
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar)
    (x : EuclideanSpace Complex (Fin 45)) : Real :=
  (suzukiProjectLogRadiusLinearCompleteEnergy
    (certificate.evenReconstructionCompletion x)
    (certificate.evenReconstructionCompletion x)).re

/-- Actual odd low-low value generated by the B2S completion reconstruction. -/
def SuzukiB2EndpointModeCertificate.oddActualLowValue
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar)
    (x : EuclideanSpace Complex (Fin 44)) : Real :=
  (suzukiProjectLogRadiusLinearCompleteEnergy
    (certificate.oddReconstructionCompletion x)
    (certificate.oddReconstructionCompletion x)).re

/-- Actual even low-far cross term. -/
def SuzukiB2EndpointModeCertificate.evenActualCross
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar)
    (x : EuclideanSpace Complex (Fin 45))
    (v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar) : Complex :=
  suzukiProjectLogRadiusLinearCompleteEnergy
    (certificate.evenReconstructionCompletion x)
    (certificate.evenFarRemainderCompletion v)

/-- Actual odd low-far cross term. -/
def SuzukiB2EndpointModeCertificate.oddActualCross
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar)
    (x : EuclideanSpace Complex (Fin 44))
    (v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar) : Complex :=
  suzukiProjectLogRadiusLinearCompleteEnergy
    (certificate.oddReconstructionCompletion x)
    (certificate.oddFarRemainderCompletion v)

/-- Actual even far-far complete-form energy. -/
def SuzukiB2EndpointModeCertificate.evenActualFarEnergy
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar)
    (v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar) : Real :=
  (suzukiProjectLogRadiusLinearCompleteEnergy
    (certificate.evenFarRemainderCompletion v)
    (certificate.evenFarRemainderCompletion v)).re

/-- Actual odd far-far complete-form energy. -/
def SuzukiB2EndpointModeCertificate.oddActualFarEnergy
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar)
    (v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar) : Real :=
  (suzukiProjectLogRadiusLinearCompleteEnergy
    (certificate.oddFarRemainderCompletion v)
    (certificate.oddFarRemainderCompletion v)).re

/-- The actual even complete-form block identity after the B2S split. -/
theorem SuzukiB2EndpointModeCertificate.evenActualBlockIdentity
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar)
    (x : EuclideanSpace Complex (Fin 45))
    (v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar) :
    (suzukiProjectLogRadiusLinearCompleteEnergy
      (certificate.evenReconstructionCompletion x +
        certificate.evenFarRemainderCompletion v)
      (certificate.evenReconstructionCompletion x +
        certificate.evenFarRemainderCompletion v)).re =
      certificate.evenActualLowValue x +
        2 * (certificate.evenActualCross x v).re +
        certificate.evenActualFarEnergy v := by
  exact suzukiProjectLogRadiusLinearCompleteEnergy_block
    (certificate.evenReconstructionCompletion x)
    (certificate.evenFarRemainderCompletion v)

/-- The actual odd complete-form block identity after the B2S split. -/
theorem SuzukiB2EndpointModeCertificate.oddActualBlockIdentity
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar)
    (x : EuclideanSpace Complex (Fin 44))
    (v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar) :
    (suzukiProjectLogRadiusLinearCompleteEnergy
      (certificate.oddReconstructionCompletion x +
        certificate.oddFarRemainderCompletion v)
      (certificate.oddReconstructionCompletion x +
        certificate.oddFarRemainderCompletion v)).re =
      certificate.oddActualLowValue x +
        2 * (certificate.oddActualCross x v).re +
        certificate.oddActualFarEnergy v := by
  exact suzukiProjectLogRadiusLinearCompleteEnergy_block
    (certificate.oddReconstructionCompletion x)
    (certificate.oddFarRemainderCompletion v)

/-! ## Legacy B3 diagnostic targets

These four far/cross propositions record the original B3 experiment exactly
and are retained for historical compatibility.  Their domains and far norm
are superseded by the corrected parity-far, physical-`L²` targets in
`SuzukiYoshidaParityFarTargets`.
-/

/-- Missing normalization bridge from actual even mode pairings to the live
DF6D4 endpoint matrix. -/
def SuzukiDF6D5B3EvenLowMatrixIdentity
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar) : Prop :=
  ∀ x : EuclideanSpace Complex (Fin 45),
    certificate.evenActualLowValue x =
      suzukiDF6D5EvenEndpointHermitianQuadratic x

/-- Missing normalization bridge from actual odd mode pairings to the live
DF6D4 endpoint matrix. -/
def SuzukiDF6D5B3OddLowMatrixIdentity
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar) : Prop :=
  ∀ x : EuclideanSpace Complex (Fin 44),
    certificate.oddActualLowValue x =
      suzukiDF6D5OddEndpointHermitianQuadratic x

/-- Missing actual-form far coercivity for the even complement. -/
def SuzukiDF6D5B3EvenFarCoercivity
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar) : Prop :=
  ∀ v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar,
    2 * ‖certificate.evenFarRemainderCompletion v‖ ^ 2 ≤
      certificate.evenActualFarEnergy v

/-- Missing actual-form far coercivity for the odd complement. -/
def SuzukiDF6D5B3OddFarCoercivity
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar) : Prop :=
  ∀ v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar,
    2 * ‖certificate.oddFarRemainderCompletion v‖ ^ 2 ≤
      certificate.oddActualFarEnergy v

/-- Missing DF6D4-residual-to-actual-cross bridge for the even complement. -/
def SuzukiDF6D5B3EvenCrossEstimate
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar) : Prop :=
  ∀ (x : EuclideanSpace Complex (Fin 45))
      (v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar),
    ‖certificate.evenActualCross x v‖ ^ 2 ≤
      (5 / 2 : Real) * suzukiDF6D5EvenCouplingHermitianQuadratic x *
        certificate.evenActualFarEnergy v

/-- Missing DF6D4-residual-to-actual-cross bridge for the odd complement. -/
def SuzukiDF6D5B3OddCrossEstimate
    (certificate :
      SuzukiB2EndpointModeCertificate suzukiProjectAStar) : Prop :=
  ∀ (x : EuclideanSpace Complex (Fin 44))
      (v : SuzukiLogRadiusLinearCompletion suzukiProjectAStar),
    ‖certificate.oddActualCross x v‖ ^ 2 ≤
      (5 / 2 : Real) * suzukiDF6D5OddCouplingHermitianQuadratic x *
        certificate.oddActualFarEnergy v

end

end RiemannHypothesisProject.Experiments.M100
