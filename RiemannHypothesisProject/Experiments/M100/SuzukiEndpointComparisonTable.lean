theorem suzukiDF6D4TabulatedComparisonSineTransformInterval_contains
    (mode : Nat) (hlower : 1 ≤ mode) (hupper : mode ≤ 602) :
    (suzukiDF6D4TabulatedComparisonSineTransformInterval mode).Contains
