theorem suzukiDF6D4TabulatedComparisonSineTransformInterval_eq
    (mode : Nat) (hlower : 1 ≤ mode) (hupper : mode ≤ 602) :
    suzukiDF6D4TabulatedComparisonSineTransformInterval mode =
      suzukiDF6D4FrozenComparisonSineTransformInterval mode := by
  cases htab : suzukiDF6D4TabulatedComparisonSineTransformInterval mode with
  | mk tabLower tabUpper =>
    cases hfrozen : suzukiDF6D4FrozenComparisonSineTransformInterval mode with
    | mk frozenLower frozenUpper =>
      have h := suzukiDF6D4TabulatedComparisonSineTransformInterval_endpoints
        mode hlower hupper
      simp only [htab, hfrozen] at h
      rcases h with ⟨hl, hu⟩
      cases hl
      cases hu
      rfl

