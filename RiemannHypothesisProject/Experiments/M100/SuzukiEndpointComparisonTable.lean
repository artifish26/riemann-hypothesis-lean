    suzukiDF6D4EvenComparisonDiagonalIntervalData.size = 256 := by
  native_decide

theorem suzukiDF6D4OddComparisonDiagonalIntervalData_size :
    suzukiDF6D4OddComparisonDiagonalIntervalData.size = 256 := by
  native_decide

def suzukiDF6D4TabulatedComparisonSineTransformInterval
    (mode : Nat) : RationalInterval :=
  suzukiDF6D4ComparisonSineTransformIntervalData[mode - 1]!

def suzukiDF6D4TabulatedEvenComparisonDiagonalInterval
    (mode : Nat) : RationalInterval :=
  suzukiDF6D4EvenComparisonDiagonalIntervalData[mode - 45]!

def suzukiDF6D4TabulatedOddComparisonDiagonalInterval
    (mode : Nat) : RationalInterval :=
  suzukiDF6D4OddComparisonDiagonalIntervalData[mode - 45]!

set_option maxHeartbeats 0 in
theorem suzukiDF6D4TabulatedComparisonSineTransformInterval_endpoints
    (mode : Nat) (hlower : 1 ≤ mode) (hupper : mode ≤ 602) :
    (suzukiDF6D4TabulatedComparisonSineTransformInterval mode).lower =
        (suzukiDF6D4FrozenComparisonSineTransformInterval mode).lower ∧
      (suzukiDF6D4TabulatedComparisonSineTransformInterval mode).upper =
        (suzukiDF6D4FrozenComparisonSineTransformInterval mode).upper := by
  interval_cases mode <;> native_decide

set_option maxHeartbeats 0 in
theorem suzukiDF6D4TabulatedEvenComparisonDiagonalInterval_endpoints
    (mode : Nat) (hlower : 45 ≤ mode) (hupper : mode ≤ 300) :
    (suzukiDF6D4TabulatedEvenComparisonDiagonalInterval mode).lower =
        (suzukiDF6D4FrozenEvenComparisonDiagonalInterval mode).lower ∧
      (suzukiDF6D4TabulatedEvenComparisonDiagonalInterval mode).upper =
