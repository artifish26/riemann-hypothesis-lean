import RiemannHypothesisProject.LiCriterion.CutoffCovariance

/-!
# M100-X04 common-cutoff arithmetic Li kernels

This experimental module lifts the checked scalar cutoff covariance to the
Lagarias Li-basis kernel. It keeps the endpoint, finite-prime, pole, and Gamma
components separate and proves their exact finite-cutoff decomposition before
any limit is taken.

The pole and Gamma coefficient sequences remain explicit parameters because
the production cutoff module does not yet identify their sum with the actual
full zeta Li coefficient. No positivity or limiting theorem is asserted here.
-/

namespace RiemannHypothesisProject
namespace Experiments
namespace M100

open ComplexCompactExhaustion

noncomputable section

/-- Symmetric natural-number distance, used to represent `|n-m|`. -/
def liIndexDistance (n m : Nat) : Nat :=
  (n - m) + (m - n)

@[simp]
theorem liIndexDistance_self (n : Nat) :
    liIndexDistance n n = 0 := by
  simp [liIndexDistance]

/-- The real Lagarias kernel generated by a natural-indexed coefficient
sequence, using symmetric natural distance for the reflected index. -/
def liCoefficientKernel
    (coefficient : Nat -> Real) (n m : Nat) : Real :=
  coefficient n + coefficient m - coefficient (liIndexDistance n m)

theorem liCoefficientKernel_add
    (first second : Nat -> Real) (n m : Nat) :
    liCoefficientKernel (fun k => first k + second k) n m =
      liCoefficientKernel first n m + liCoefficientKernel second n m := by
  simp only [liCoefficientKernel]
  ring

theorem liCoefficientKernel_sub
    (first second : Nat -> Real) (n m : Nat) :
    liCoefficientKernel (fun k => first k - second k) n m =
      liCoefficientKernel first n m - liCoefficientKernel second n m := by
  simp only [liCoefficientKernel]
  ring

theorem liCoefficientKernel_self
    (coefficient : Nat -> Real) (hzero : coefficient 0 = 0) (n : Nat) :
    liCoefficientKernel coefficient n n = 2 * coefficient n := by
  simp [liCoefficientKernel, hzero]
  ring

/-- The common-cutoff endpoint component of the Li-basis matrix. -/
def liZeroEndpointKernel (N n m : Nat) : Real :=
  liCoefficientKernel (fun k => liZeroEndpointCutoff k (N : Real)) n m

/-- The common-cutoff finite-prime component of the Li-basis matrix. -/
def liFinitePrimeKernel (N n m : Nat) : Real :=
  liCoefficientKernel (fun k => liFinitePrimeKernelCutoff k N) n m

/-- The endpoint-minus-prime covariance component of the Li-basis matrix. -/
def liCutoffCovarianceKernel (N n m : Nat) : Real :=
  liCoefficientKernel (fun k => liCutoffCovariance k N) n m

/-- The scalar cutoff covariance lifts exactly to endpoint kernel minus
finite-prime kernel at the same natural cutoff. -/
theorem liCutoffCovarianceKernel_eq_endpoint_sub_finitePrime
    (N n m : Nat) :
    liCutoffCovarianceKernel N n m =
      liZeroEndpointKernel N n m - liFinitePrimeKernel N n m := by
  simp only [liCutoffCovarianceKernel, liZeroEndpointKernel,
    liFinitePrimeKernel, liCoefficientKernel, liCutoffCovariance]
  ring

/-- One finite von Mangoldt atom in the concrete prime kernel. -/
def liFinitePrimeAtomKernel (q n m : Nat) : Real :=
  ArithmeticFunction.vonMangoldt q / q *
    (liInverseMellinKernel n ((q : Real)⁻¹) +
      liInverseMellinKernel m ((q : Real)⁻¹) -
        liInverseMellinKernel (liIndexDistance n m) ((q : Real)⁻¹))

/-- The finite-prime matrix is the exact sum of its prime-power atoms. This is
an algebraic decomposition only; the atom matrices are not asserted PSD. -/
theorem liFinitePrimeKernel_eq_atomSum (N n m : Nat) :
    liFinitePrimeKernel N n m =
      ∑ q ∈ Finset.Icc 1 N, liFinitePrimeAtomKernel q n m := by
  simp only [liFinitePrimeKernel, liCoefficientKernel,
    liFinitePrimeKernelCutoff, liFinitePrimeAtomKernel]
  rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro q hq
  ring

/-- The weighted renormalized-prime-moment combination at one Li index. -/
def liPrimeMomentRemainderCombination (n N : Nat) : Real :=
  ∑ j ∈ Finset.range n,
    (-1 : Real) ^ j * (n.choose (j + 1) : Real) / j.factorial *
      liPrimeMomentRemainder j N

/-- The common-cutoff matrix is exactly the three-index combination of the
renormalized moment sums. All three entries use the same cutoff. -/
theorem liCutoffCovarianceKernel_eq_primeMomentRemainderCombination
    (N n m : Nat) (hN : 0 < N) :
    liCutoffCovarianceKernel N n m =
      -liPrimeMomentRemainderCombination n N -
        liPrimeMomentRemainderCombination m N +
          liPrimeMomentRemainderCombination (liIndexDistance n m) N := by
  rw [liCutoffCovarianceKernel, liCoefficientKernel,
    liCutoffCovariance_eq_primeMomentRemainderSum n N hN,
    liCutoffCovariance_eq_primeMomentRemainderSum m N hN,
    liCutoffCovariance_eq_primeMomentRemainderSum (liIndexDistance n m) N hN]
  simp only [liPrimeMomentRemainderCombination]
  ring

/-- A cutoff coefficient with the non-prime pole and Gamma sequences retained
as separate visible inputs. -/
def liArithmeticCutoffCoefficient
    (pole gamma : Nat -> Real) (N n : Nat) : Real :=
  liCutoffCovariance n N + pole n + gamma n

/-- The complete experimental prime/pole/Gamma finite-cutoff kernel. -/
def liArithmeticCutoffKernel
    (pole gamma : Nat -> Real) (N n m : Nat) : Real :=
  liCoefficientKernel (liArithmeticCutoffCoefficient pole gamma N) n m

/-- Exact component matrix decomposition before limits. -/
theorem liArithmeticCutoffKernel_eq_components
    (pole gamma : Nat -> Real) (N n m : Nat) :
    liArithmeticCutoffKernel pole gamma N n m =
      liCutoffCovarianceKernel N n m +
        liCoefficientKernel pole n m +
          liCoefficientKernel gamma n m := by
  simp only [liArithmeticCutoffKernel, liArithmeticCutoffCoefficient,
    liCutoffCovarianceKernel, liCoefficientKernel]
  ring

end

end M100
end Experiments
end RiemannHypothesisProject
